<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/we_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:padding="12dp"
    android:background="@drawable/bg_wid_card">

    <LinearLayout
        android:id="@+id/we_circulo"
        android:layout_width="46dp"
        android:layout_height="46dp"
        android:gravity="center"
        android:background="@drawable/bg_wid_circulo_on">

        <ImageView
            android:id="@+id/we_icono"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_mic"
            android:contentDescription="@string/app_name" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="12dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/we_titulo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="IgnoAssist"
            android:textColor="#0F172A"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/we_sub"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Toca para encender"
            android:textColor="#64748B"
            android:textSize="12sp" />
    </LinearLayout>
</LinearLayout>
